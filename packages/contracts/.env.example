# Get from Alchemy: https://alchemy.com (free tier)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Your MetaMask private key (NEVER commit the real .env file)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Get from Etherscan: https://etherscan.io/myapikey (for contract verification)
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
