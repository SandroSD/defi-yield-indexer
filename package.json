{
  "name": "defi-yield-portfolio",
  "private": true,
  "description": "Professional DeFi Yield Indexer & Analytics Portfolio",
  "scripts": {
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "deploy": "pnpm --filter @portfolio/contracts deploy",
    "install:all": "pnpm install",
    "dev": "concurrently -n \"NODE,LISTENER,SERVER,WEB\" -c \"magenta,yellow,blue,cyan\" \"pnpm node\" \"pnpm --filter @portfolio/indexer dev:listener\" \"pnpm --filter @portfolio/indexer dev:server\" \"pnpm --filter @portfolio/frontend dev\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  }
}
